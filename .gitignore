# ============================================================================
# HYDRIVIA - .gitignore
# ============================================================================

# --- Node.js / npm ---
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# --- Environment & Secrets ---
scratch/
.env
.env.*
!.env.example
.env.local
.env.*.local
secrets.h
backend/.env

# --- Build output ---
dist/
build/
.next/
out/
frontend/dist/

# --- Coverage ---
coverage/

# --- Runtime files ---
*.pid
*.seed
*.pid.lock

# --- SQLite database files & backups ---
backend/data/*.sqlite
backend/data/*.sqlite-journal
backend/data/*.sqlite-wal
backend/data/*.sqlite-shm
backend/data/*.db
backend/data/backup_sqlite/

# --- OS generated files ---
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# --- IDE / Editor ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- Logs ---
logs/
*.log

# --- Misc ---
*.tmp
*.bak
*.orig
.cache/
