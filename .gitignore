# ============================================================================
# HYDRIVIA - .gitignore
# ============================================================================

# --- Node.js / npm ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Environment & Secrets ---
.env
.env.local
.env.*.local
secrets.h
backend/.env

# --- Build output ---
frontend/dist/

# --- SQLite database files ---
backend/data/*.sqlite
backend/data/*.sqlite-journal
backend/data/*.sqlite-wal
backend/data/*.sqlite-shm

# --- OS generated files ---
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# --- IDE / Editor ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- Logs ---
logs/
*.log

# --- Misc ---
*.tmp
*.bak
*.orig
.cache/
