# ============================================================================
# HYDRIVIA Backend Environment Configuration Template
# ============================================================================

PORT=5000
NODE_ENV=development

# Database (Supabase PostgreSQL via Prisma ORM)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"

# FusionAI Webhook Secret
FUSIONAI_WEBHOOK_SECRET=your_fusionai_secret_token_here

# JWT Secret
JWT_SECRET=your_super_secret_jwt_key_here

# Admin Credentials
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=your_secure_password_here

# MQTT HiveMQ Cloud Broker
MQTT_SERVER=your_hivemq_cluster_id.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_PROTOCOL=mqtts
MQTT_USERNAME=your_mqtt_username
MQTT_PASSWORD=your_mqtt_password
MQTT_CLIENT_ID=hydrivia-backend-gateway

# Set to true to generate realistic simulated IoT telemetry if broker is offline
MQTT_SIMULATE=false

# Site GPS Location (for Open-Meteo & SoilGrids)
SITE_LATITUDE=33.5731
SITE_LONGITUDE=-7.5898
SITE_NAME=Station Agricole HYDRIVIA - Parcelle 1
