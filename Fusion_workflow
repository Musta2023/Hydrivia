                        "code": "function parseDateDDMMYYYY(dateString) {\n  if (!dateString) {\n    return null;\n  }\n\n  const [day, month, year] = dateString.split(\"/\").map(Number);\n\n  if (!day || !month || !year) {\n    return null;\n  }\n\n  return new Date(Date.UTC(year, month - 1, day));\n}\n\nfunction daysBetween(startDate, endDate) {\n  if (!startDate || !endDate) {\n    return null;\n  }\n\n  const msPerDay = 1000 * 60 * 60 * 24;\n\n  return Math.floor((endDate.getTime() - startDate.getTime()) / msPerDay);\n}\n\nfunction numberOrNull(value) {\n  if (value === null || value === undefined || value === \"\") {\n    return null;\n  }\n\n  const number = Number(value);\n\n  return Number.isFinite(number) ? number : null;\n}\n\nfunction sum(values = []) {\n  return values.reduce((total, value) => {\n    const number = Number(value);\n    return total + (Number.isFinite(number) ? number : 0);\n  }, 0);\n}\n\nfunction min(values = []) {\n  const valid = values.map(Number).filter(Number.isFinite);\n\n  return valid.length ? Math.min(...valid) : null;\n}\n\nfunction max(values = []) {\n  const valid = values.map(Number).filter(Number.isFinite);\n\n  return valid.length ? Math.max(...valid) : null;\n}\n\nfunction parseWeatherTime(time) {\n  if (!time) return null;\n\n  const hasTimezone = time.endsWith(\"Z\") || /[+-]\\d{2}:\\d{2}$/.test(time);\n  \n  const date = new Date(hasTimezone ? time : `${time}:00Z`);\n  \n  return Number.isNaN(date.getTime()) ? null : date;\n}\n\nfunction findNextHourIndex(times = [], referenceDate = new Date()) {\n  for (let i = 0; i < times.length; i++) {\n    const forecastDate = parseWeatherTime(times[i]);\n\n    if (forecastDate && forecastDate > referenceDate) {\n      return i;\n    }\n  }\n\n  return -1;\n}\n\nfunction buildHourlyForecast(hourly, startIndex, hours = 6) {\n  if (startIndex < 0) return [];\n\n  const availableCount = hourly.time?.length ?? 0;\n\n  const endIndex = Math.min(startIndex + hours, availableCount);\n\n  const forecast = [];\n\n  for (let i = startIndex; i < endIndex; i++) {\n    const date = parseWeatherTime(hourly.time?.[i]);\n\n    forecast.push({\n      timestamp: date ? date.toISOString() : null,\n      hoursFromNow: i - startIndex + 1,\n      temperatureC: numberOrNull(hourly.temperature_2m?.[i]),\n      precipitationProbabilityPct: numberOrNull(hourly.precipitation_probability?.[i]),\n      precipitationMm: numberOrNull(hourly.precipitation?.[i]) ?? 0,\n      rainMm: numberOrNull(hourly.rain?.[i]) ?? 0,\n      referenceEvapotranspirationMm: numberOrNull(hourly.et0_fao_evapotranspiration?.[i]) ?? 0,\n      relativeHumidityPct: numberOrNull(hourly.relative_humidity_2m?.[i]),\n      windSpeedKmh: numberOrNull(hourly.wind_speed_10m?.[i])\n    });\n  }\n\n  return forecast;\n}\n\nfunction build24HourSummary(hourly, startIndex) {\n  if (startIndex < 0) {\n    return {\n      hoursAvailable: 0,\n      temperatureMinC: null,\n      temperatureMaxC: null,\n      precipitationProbabilityMaxPct: null,\n      expectedPrecipitationMm: 0,\n      expectedRainMm: 0,\n      referenceEvapotranspirationMm: 0,\n      relativeHumidityMinPct: null,\n      relativeHumidityMaxPct: null,\n      windSpeedMaxKmh: null\n    };\n  }\n\n  const endIndex = Math.min(\n    startIndex + 24,\n    hourly.time?.length ?? 0\n  );\n\n  const slice = (array = []) => array.slice(startIndex, endIndex);\n\n  return {\n    hoursAvailable: endIndex - startIndex,\n    temperatureMinC: min(slice(hourly.temperature_2m)),\n    temperatureMaxC: max(slice(hourly.temperature_2m)),\n    precipitationProbabilityMaxPct: max(slice(hourly.precipitation_probability)),\n    expectedPrecipitationMm: Number(sum(slice(hourly.precipitation)).toFixed(2)),\n    expectedRainMm: Number(sum(slice(hourly.rain)).toFixed(2)),\n    referenceEvapotranspirationMm: Number(sum(slice(hourly.et0_fao_evapotranspiration)).toFixed(2)),\n    relativeHumidityMinPct: min(slice(hourly.relative_humidity_2m)),\n    relativeHumidityMaxPct: max(slice(hourly.relative_humidity_2m)),\n    windSpeedMaxKmh: max(slice(hourly.wind_speed_10m))\n  };\n}\n\nfunction buildDecisionContext({ mqttPayload, soilGridsResponse, weatherResponse, cropDbResponse }) {\n  const now = new Date();\n\n  const soilBody = soilGridsResponse?.body ?? {};\n  const weatherBody = weatherResponse?.body ?? {};\n  const hourly = weatherBody?.hourly ?? {};\n\n  const observationTime = mqttPayload?.timestamp ? new Date(mqttPayload.timestamp) : now;\n  const validObservationTime = Number.isNaN(observationTime.getTime()) ? now : observationTime;\n\n  const cropLookup = {};\n\n  for (const row of cropDbResponse?.rows ?? []) {\n    const cropId = row.crop_id;\n    const zoneId = row.zone_id;\n    const zoneSurface = row.zone_surface;\n    const cropName = row.crop_type;\n    const variety = row.crop_variety;\n\n    let plantingDate = null;\n\n    if (row.planting_date instanceof Date) {\n      plantingDate = row.planting_date;\n    } else if (typeof row.planting_date === \"string\" && row.planting_date) {\n      plantingDate = new Date(`${row.planting_date}T00:00:00Z`);\n\n      if (Number.isNaN(plantingDate.getTime())) {\n        plantingDate = null;\n      }\n    }\n\n    cropLookup[zoneId] = {\n      cropId,\n      zoneSurfaceM2: numberOrNull(zoneSurface),\n      name: cropName ?? null,\n      variety: variety ?? null,\n      plantingDate: plantingDate ? plantingDate.toISOString() : null,\n      daysSincePlanting: plantingDate ? daysBetween(plantingDate, validObservationTime) : null\n    };\n  }\n\n  const nextHourIdx = findNextHourIndex(hourly.time ?? [], now);\n  const next6Hours = buildHourlyForecast(hourly, nextHourIdx, 6);\n  const next24HoursSummary = build24HourSummary(hourly, nextHourIdx);\n\n  const firstForecastTime = nextHourIdx >= 0 ? parseWeatherTime(hourly.time?.[nextHourIdx]) : null;\n\n  const weatherForecast = {\n    timezone: weatherBody?.timezone ?? null,\n    forecastStart: firstForecastTime ? firstForecastTime.toISOString() : null,\n    next6Hours,\n    next24HoursSummary\n  };\n\n  const probabilities = soilBody.wrb_class_probability ?? [];\n  const mainSoilProbability = probabilities.find(item => item[0] === soilBody.wrb_class_name)?.[1] ?? null;\n  const alternativeClassifications = probabilities.filter(item => item[0] !== soilBody.wrb_class_name).slice(0, 3).map(item => ({ name: item[0], probabilityPct: item[1] }));\n\n  const zones = (mqttPayload?.cropZones ?? []).map(zone => {\n    const crop = cropLookup[zone.zoneId] ?? {};\n\n    return {\n      zoneId: zone.zoneId ?? null,\n      zoneSurfaceM2: crop.zoneSurfaceM2 ?? null,\n      soilMoisturePct: numberOrNull(zone.soilMoisturePct),\n      cropType: crop.name ?? null,\n      cropVariety: crop.variety ?? null,\n      plantingDate: crop.plantingDate ?? null,\n      daysSincePlanting: crop.daysSincePlanting ?? null\n    };\n  });\n\n  return {\n    deviceInfo: {\n      deviceId: mqttPayload?.metadata?.deviceId ?? null\n    },\n    fieldInfo: {\n      latitude: numberOrNull(mqttPayload?.fieldLocation?.latitude),\n      longitude: numberOrNull(mqttPayload?.fieldLocation?.longitude),\n      elevationM: numberOrNull(weatherBody?.elevation)\n    },\n    waterInfo: {\n      availableMl: numberOrNull(mqttPayload?.waterLevel?.available_ml) ?? 0\n    },\n    sensorInfo: {\n      temperatureC: numberOrNull(mqttPayload?.sensorData?.temperatureC),\n      relativeHumidityPct: numberOrNull(mqttPayload?.sensorData?.humidityPct)\n    },\n    soilInfo: {\n      classification: soilBody?.wrb_class_name ?? null,\n      classificationProbabilityPct: mainSoilProbability,\n      alternativeClassifications\n    },\n    forecastInfo: weatherForecast,\n    zoneInfo: zones\n  };\n}\n\nconst decisionContext = buildDecisionContext({\n  mqttPayload: outputs.sanitize_analysis_data.success,\n  soilGridsResponse: outputs.get_soil_data.success,\n  weatherResponse: outputs.get_weather_data.success,\n  cropDbResponse: outputs.get_crop_data.success\n});\n\nreturn decisionContext;"
